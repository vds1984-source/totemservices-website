# Keep this folder closed until server-side directory authentication is configured.
# hPanel: protect ONLY public_html/totem-crm-test, then remove the deny line below.
# Keep AuthType, AuthUserFile and Require valid-user supplied by hPanel.
Options -Indexes
DirectoryIndex index.php
Require all denied

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "private, no-store, max-age=0"
</IfModule>
