RewriteEngine On

# Redirect only explicit index.html requests, never DirectoryIndex rewrites.
# Query parameters are preserved. GET/HEAD only: do not redirect form POSTs.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ https://totemservices.org/$1 [R=301,L]

# Canonical hostname: redirect www to non-www and preserve the full path
RewriteCond %{HTTP_HOST} ^www\.totemservices\.org$ [NC]
RewriteRule ^ https://totemservices.org%{REQUEST_URI} [R=301,L]
